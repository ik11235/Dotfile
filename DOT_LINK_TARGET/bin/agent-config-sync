#!/usr/bin/env bash
set -euo pipefail

# Claude Code の subagents (~/.claude/agents/*.md) を正本として、
# Antigravity 用 (~/.gemini/config/agents/*.md) を生成・差分チェックする。
#
# Usage:
#   agent-config-sync [sync] [--src DIR] [--dst DIR] [--verify]
#   agent-config-sync check  [--src DIR] [--dst DIR] [--diff]

MARKER="# Generated by agent-config-sync"

usage() {
  cat <<'EOF'
Usage:
  agent-config-sync [sync] [--src DIR] [--dst DIR] [--verify]
  agent-config-sync check  [--src DIR] [--dst DIR] [--diff]
EOF
}

render_agent() {
  local src_file=$1
  local base
  base=$(basename "$src_file")

  awk -v src_name="$base" -v marker="$MARKER" '
    BEGIN {
      in_fm = 0
      fm_done = 0
      capture_desc = 0
      desc_is_block = 0
      name_line = ""
      desc_block = ""
      model_val = ""
      body = ""
      has_body = 0
    }
    NR == 1 && $0 == "---" {
      in_fm = 1
      next
    }
    in_fm && $0 == "---" {
      in_fm = 0
      fm_done = 1
      capture_desc = 0
      next
    }
    in_fm {
      if (capture_desc) {
        if ($0 ~ /^[ \t]+/) {
          desc_block = desc_block "\n" $0
          next
        }
        if (desc_is_block && $0 == "") {
          desc_block = desc_block "\n"
          next
        }
        capture_desc = 0
      }
      if ($0 ~ /^name:[ \t]*/) {
        name_line = $0
      } else if ($0 ~ /^description:[ \t]*/) {
        desc_block = $0
        capture_desc = 1
        desc_is_block = ($0 ~ /^description:[ \t]*([|>][-+]?[ \t]*|[ \t]*)$/)
      } else if ($0 ~ /^model:[ \t]*/) {
        val = $0
        sub(/^model:[ \t]*/, "", val)
        sub(/[ \t]*#.*$/, "", val)
        gsub(/^[ \t"\047]+|[ \t"\047]+$/, "", val)
        model_val = val
      }
      next
    }
    fm_done {
      if (!has_body) {
        body = $0
        has_body = 1
      } else {
        body = body "\n" $0
      }
    }
    END {
      if (!fm_done || name_line == "" || desc_block == "") {
        print "error: missing valid frontmatter (name/description) in " src_name > "/dev/stderr"
        exit 2
      }
      sub(/\n+$/, "", desc_block)
      mapped_model = ""
      if (model_val == "haiku" || model_val ~ /^claude-haiku/) {
        mapped_model = "flash"
      } else if (model_val == "sonnet" || model_val ~ /^claude-sonnet/) {
        mapped_model = "inherit"
      } else if (model_val == "opus" || model_val ~ /^claude-opus/) {
        mapped_model = "pro"
      } else if (model_val == "flash" || model_val == "pro" || model_val == "inherit") {
        mapped_model = model_val
      }
      print "---"
      print marker " from ~/.claude/agents/" src_name ". Do not edit directly."
      print name_line
      print desc_block
      if (mapped_model != "") {
        print "model: " mapped_model
      }
      print "---"
      if (has_body) {
        print body
      }
    }
  ' "$src_file"
}

extract_name() {
  local file=$1
  awk '
    NR == 1 && $0 == "---" { in_fm = 1; next }
    in_fm && $0 == "---" { exit }
    in_fm && $0 ~ /^name:[ \t]*/ {
      val = $0
      sub(/^name:[ \t]*/, "", val)
      sub(/[ \t]*#.*$/, "", val)
      gsub(/^[ \t"\047]+|[ \t"\047]+$/, "", val)
      print val
      exit
    }
  ' "$file"
}

is_managed_file() {
  local file=$1
  [ -f "$file" ] && grep -qF "$MARKER" "$file" 2>/dev/null
}

main() {
  local cmd="sync"
  local src_dir="${AGENT_SYNC_SRC_DIR:-$HOME/.claude/agents}"
  local dst_dir="${AGENT_SYNC_DST_DIR:-$HOME/.gemini/config/agents}"
  local show_diff=0
  local verify_agy=0

  if [ $# -gt 0 ]; then
    case "$1" in
      sync|check)
        cmd=$1
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      --*)
        ;;
      *)
        echo "error: unknown subcommand: $1" >&2
        usage >&2
        exit 2
        ;;
    esac
  fi

  while [ $# -gt 0 ]; do
    case "$1" in
      --src)
        [ $# -ge 2 ] || { echo "error: --src requires a directory" >&2; exit 2; }
        src_dir=$2
        shift 2
        ;;
      --dst)
        [ $# -ge 2 ] || { echo "error: --dst requires a directory" >&2; exit 2; }
        dst_dir=$2
        shift 2
        ;;
      --diff)
        show_diff=1
        shift
        ;;
      --verify)
        verify_agy=1
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        echo "error: unknown option: $1" >&2
        usage >&2
        exit 2
        ;;
    esac
  done

  if [ ! -d "$src_dir" ]; then
    echo "error: source directory not found: $src_dir" >&2
    exit 2
  fi

  local tmp_dir
  tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/agent-config-sync.XXXXXX")
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp_dir'" EXIT

  shopt -s nullglob

  if [ "$cmd" = "sync" ]; then
    mkdir -p "$dst_dir"
    local updated=0
    local unchanged=0
    local removed=0
    local expected_names=()

    local src_file base dst_file rendered name
    for src_file in "$src_dir"/*.md; do
      base=$(basename "$src_file")
      dst_file="${dst_dir}/${base}"
      rendered="${tmp_dir}/${base}"
      render_agent "$src_file" > "$rendered"
      name=$(extract_name "$rendered")
      if [ -n "$name" ]; then
        expected_names+=("$name")
      fi

      if [ -f "$dst_file" ] && cmp -s "$rendered" "$dst_file"; then
        unchanged=$((unchanged + 1))
      else
        cp "$rendered" "$dst_file"
        echo "SYNCED: ${base}"
        updated=$((updated + 1))
      fi
    done

    for dst_file in "$dst_dir"/*.md; do
      base=$(basename "$dst_file")
      if [ ! -f "${src_dir}/${base}" ] && is_managed_file "$dst_file"; then
        rm -f "$dst_file"
        echo "REMOVED: ${base}"
        removed=$((removed + 1))
      fi
    done

    echo "Done: ${updated} synced, ${unchanged} unchanged, ${removed} removed."

    if [ "$verify_agy" -eq 1 ]; then
      if ! command -v agy >/dev/null 2>&1; then
        echo "error: agy command not found for --verify" >&2
        exit 1
      fi
      local agy_out
      agy_out=$(agy agents 2>&1)
      local missing_verify=0
      if [ "${#expected_names[@]}" -gt 0 ]; then
        for name in "${expected_names[@]}"; do
          if ! printf '%s\n' "$agy_out" | grep -qxF "$name"; then
            echo "VERIFY_FAILED: agent '$name' not listed by 'agy agents'" >&2
            missing_verify=1
          fi
        done
      fi
      if [ "$missing_verify" -ne 0 ]; then
        exit 1
      fi
      echo "Verified with 'agy agents': all ${#expected_names[@]} agents recognized."
    fi
  else
    local drift=0
    local src_file base dst_file rendered

    for src_file in "$src_dir"/*.md; do
      base=$(basename "$src_file")
      dst_file="${dst_dir}/${base}"
      rendered="${tmp_dir}/${base}"
      render_agent "$src_file" > "$rendered"

      if [ ! -f "$dst_file" ]; then
        echo "MISSING: ${base}"
        drift=1
      elif ! cmp -s "$rendered" "$dst_file"; then
        echo "DRIFT: ${base}"
        if [ "$show_diff" -eq 1 ]; then
          diff -u --label "expected/${base}" --label "actual/${base}" "$rendered" "$dst_file" || true
        fi
        drift=1
      fi
    done

    if [ -d "$dst_dir" ]; then
      for dst_file in "$dst_dir"/*.md; do
        base=$(basename "$dst_file")
        if [ ! -f "${src_dir}/${base}" ] && is_managed_file "$dst_file"; then
          echo "ORPHAN: ${base}"
          drift=1
        fi
      done
    fi

    exit "$drift"
  fi
}

main "$@"
