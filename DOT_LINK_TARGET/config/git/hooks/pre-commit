#!/bin/bash

# `git --literal-pathspecs` (Magit の既定) で commit されると GIT_LITERAL_PATHSPECS=1 が hook にも
# 引き継がれ、以降で使う :(literal) が magic として解釈されずに検査が素通りする。
# 呼び出し元の pathspec 設定は hook 内の git には不要なので、関連する環境変数をまとめて外す
unset GIT_LITERAL_PATHSPECS GIT_GLOB_PATHSPECS GIT_NOGLOB_PATHSPECS GIT_ICASE_PATHSPECS

source "$(dirname "$0")/_local-hook-exec"

# https://dev.classmethod.jp/etc/git_aws_access_key/
## AWSアクセスキーをgitに誤って登録しないようにする

GREP_RESULT=$(git diff --cached | grep KEY | grep AKIA)
if [ -n "${GREP_RESULT}" ]; then
  echo 'AWS_ACCESS_KEY might be in this index. Please check with git diff --cached'
  echo "${GREP_RESULT}"
  exit 1
fi

## stage 済みファイル一覧（空白入りパスに対応するため NUL 区切りで読む）
staged_files=()
while IFS= read -r -d '' file; do staged_files+=("$file"); done < <(git diff --cached --name-only -z)
## 新規追加・リネーム先のみ（削除・単純変更は含まない）
added_files=()
while IFS= read -r -d '' file; do added_files+=("$file"); done < <(git diff --cached --name-only --diff-filter=AR -z)
## 内容を検査する対象（削除 (D) だけを除く。型変更 T (symlink <-> 通常ファイル) も含める）
content_files=()
while IFS= read -r -d '' file; do content_files+=("$file"); done < <(git diff --cached --name-only --diff-filter=d -z)

# macでときより挿入される制御文字(0x08)が含まれないかチェックする
## 念の為、近似の制御文字も合わせてチェック
## https://dev.classmethod.jp/etc/vscode-mac-control-character-0x08/
## 対象は今回 stage されたファイルの index 上の内容のみ。
## 作業ツリー全体を見ると、既存ファイルに残る制御文字で無関係なコミットまで止まってしまう

## homebrew/homebrew-coreにはコード内に制御文字が含まれているのでチェックから除外する
## ファイル名は :(literal) を前置して pathspec として渡す。
## そのまま渡すと ":" 始まりの名前が pathspec magic に、"*" 等を含む名前が glob として解釈される
if [ "$(basename "$(git rev-parse --show-toplevel)")" != "homebrew-core" ] && [ ${#content_files[@]} -gt 0 ]; then
  if git grep -I -n --cached $'[\x01-\x08\x0B\x0C\x0E-\x1F\x7F]' -- "${content_files[@]/#/:(literal)}"; then
    echo "Hit control code."
    exit 1
  fi
fi

# git commit時に自動的に行末の空白を修正する
## https://qiita.com/k0kubun/items/8f6d7eded1d833187449

if git rev-parse --verify HEAD >/dev/null 2>&1; then
  against=HEAD
else
  # Initial commit: diff against an empty tree object
  against=$(git hash-object -t tree /dev/null)
fi

## sed -i は GNU (Linux) と BSD (macOS) で引数が異なるため、ループの外で一度だけ判定しておく
if sed --version >/dev/null 2>&1; then
  sed_inplace_opts=(-i)
else
  sed_inplace_opts=(-i '')
fi

## `git diff-index --check` の出力 "path:line: trailing whitespace." から path と line を取り出す。
## 他の問題と併記される "path:line: trailing whitespace, space before tab in indent." の形式も拾う。
## メッセージ行の次には問題行の本文も出力されるため、行末を固定した正規表現でメッセージ行だけを拾い、
## さらに file が stage 済みの検査対象に含まれ line が数値であることを確かめてから sed と git add を行う
is_content_file() {
  local f
  for f in "${content_files[@]}"; do
    [ "$f" = "$1" ] && return 0
  done
  return 1
}
while IFS= read -r entry; do
  entry=${entry%%: trailing whitespace*}
  file=${entry%:*}
  line=${entry##*:}
  if ! [[ "$line" =~ ^[0-9]+$ ]] || ! is_content_file "$file"; then
    continue
  fi
  sed "${sed_inplace_opts[@]}" -e "${line}s/ *$//" "$file"
  git add "$file"
done < <(git diff-index --check --cached "$against" -- | grep -E ': trailing whitespace(\.|, [^:]*\.)$')

# 禁止ワードが含まれていないかチェック
prohibited_word_check=""
prohibited_word_list=()
hook_dir=$(dirname "$0")

## グローバルな単語リスト取得
if [ -d "${hook_dir}/git_prohibited_words/" ]; then
  while IFS='' read -r line; do prohibited_word_list+=("$line"); done < <(cat "${hook_dir}/git_prohibited_words/"*)
fi

## プライベートな単語リスト取得
if [ -d "${hook_dir}/git_prohibited_words_private/" ]; then
  while IFS='' read -r line; do prohibited_word_list+=("$line"); done < <(cat "${hook_dir}/git_prohibited_words_private/"*)
fi

## コメント行・空行を除いた有効な単語だけを残す
prohibited_words=()
for prohibited_word in "${prohibited_word_list[@]}"; do
  [[ "$prohibited_word" =~ ^[[:space:]]*# ]] && continue
  [[ "$prohibited_word" =~ ^[[:space:]]*$ ]] && continue
  prohibited_words+=("$prohibited_word")
done

if [ ${#prohibited_words[@]} -gt 0 ]; then
  ## 追加行(+)のみチェック。削除行(-)は元々含まれていたものを消すだけなので許容する。
  ## ファイルヘッダは必ず "+++ " (スペース付き) なので、"++i" のような追加行を誤除外しない。
  ## git diff はファイルごとに 1 回だけ取り、単語ごとのループは grep だけにする。
  ## ファイル名は制御文字チェックと同じ理由で :(literal) を前置する
  for file in "${staged_files[@]}"; do
    added_lines=$(git diff --cached -U0 -- ":(literal)${file}" | grep '^+' | grep -v '^+++ ') || continue
    for prohibited_word in "${prohibited_words[@]}"; do
      if result=$(grep -i "${prohibited_word}" <<<"${added_lines}"); then
        prohibited_word_check+=$'\n'"${file}"$'\n'"${result}"$'\n'
      fi
    done
  done

  ## ファイル名のチェック（新規追加・リネーム先のパスのみ。削除は許容する）
  for file in "${added_files[@]}"; do
    for prohibited_word in "${prohibited_words[@]}"; do
      if echo "$file" | grep -qi "${prohibited_word}"; then
        prohibited_word_check+=$'\n'"filename: ${file}"$'\n'
      fi
    done
  done
fi

if [ -n "$prohibited_word_check" ]; then
  echo "$prohibited_word_check"
  exit 1
fi
